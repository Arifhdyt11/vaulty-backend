{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": ["../vaulty-vault"],
    "allow": [
      "Read(../vaulty-vault/**)",
      "Edit(../vaulty-vault/**)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make vet)",
      "Bash(make fmt)",
      "Bash(make verify)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(gofmt:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(.claude/skills/verify/scripts/verify.sh:*)"
    ],
    "ask": [
      "Bash(make migrate)",
      "Bash(make dev-deps)",
      "Bash(make api)",
      "Bash(make worker)",
      "Bash(go run:*)",
      "Bash(go get:*)",
      "Bash(go mod tidy)",
      "Bash(docker:*)",
      "Bash(psql:*)",
      "Bash(redis-cli:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.p8)",
      "Read(./**/service-account*.json)",
      "Read(./storage/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(docker compose down -v:*)",
      "Edit(../vaulty-vault/.obsidian/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-env-access.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-fmt-vet.sh", "timeout": 90 },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/migration-reminder.sh" }
        ]
      }
    ]
  }
}
