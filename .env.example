# Salin ke .env untuk development. Di production env datang dari orchestrator/systemd.
APP_ENV=development
HTTP_ADDR=:8081
BASE_URL=http://localhost:8081
APP_SECRET=ganti-dengan-string-acak-panjang
AUTO_MIGRATE=true
LOG_JSON=false

# docker compose up -d → Postgres (pgvector) di 5435, Redis di 6380, MinIO di 9000/9001
DATABASE_URL=postgres://vaulty:vaulty@localhost:5435/vaulty?sslmode=disable
REDIS_URL=redis://localhost:6380/0
DB_MAX_CONNS=10

# Token (ADR-008)
ACCESS_TTL=1h
REFRESH_TTL=2160h

# Registrasi: true = terbuka; false = hanya ALLOWED_EMAILS (pisahkan koma)
REGISTRATION_OPEN=true
ALLOWED_EMAILS=
# Client ID OAuth Google (Android/iOS/web), pisahkan koma. Kosong = login Google nonaktif.
GOOGLE_CLIENT_IDS=

# Object storage S3-compatible (ADR-004). Kosongkan S3_ENDPOINT untuk disk lokal (dev saja).
# MinIO lokal: S3_ENDPOINT=localhost:9000 S3_USE_SSL=false S3_ACCESS_KEY=vaulty S3_SECRET_KEY=vaultyvaulty
# Cloudflare R2: S3_ENDPOINT=<account>.r2.cloudflarestorage.com S3_USE_SSL=true S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=vaulty
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false
S3_PUBLIC_URL=
LOCAL_STORAGE_DIR=./storage

# Provider AI: API kompatibel OpenAI (ADR-005). Dev memakai Hermes (chat) + 9router (embedding)
# di sipantas lewat SSH tunnel: jalankan `make tunnel` di terminal terpisah. Jangan pakai Ollama lokal.
# Key: salin dari env container vaulty-api di sipantas (OPENAI_API_KEY → AI_API_KEY,
# OPENAI_EMBEDDING_API_KEY → AI_EMBED_API_KEY).
AI_BASE_URL=http://localhost:8642/v1
AI_API_KEY=
AI_CHAT_MODEL=hermes-vaulty
AI_CHAT_MODEL_PRO=
# Vision (gambar & frame video) dan STT langsung ke 9router; Hermes hanya teks (ADR-015).
AI_VISION_BASE_URL=http://localhost:20128/v1
AI_VISION_API_KEY=
AI_VISION_MODEL=openai/gpt-4o-mini
AI_EMBED_BASE_URL=http://localhost:20128/v1
AI_EMBED_API_KEY=
AI_EMBED_MODEL=openai/text-embedding-3-small
AI_EMBED_DIM=1536
AI_STT_BASE_URL=http://localhost:20128/v1
AI_STT_API_KEY=
AI_STT_MODEL=groq/whisper-large-v3
# Isi video (YouTube/TikTok/Instagram, Pro): butuh yt-dlp + ffmpeg di mesin worker.
VIDEO_MAX_FRAMES=6
AI_MAX_STT_MINUTES=30
# Catatan: ganti model embedding memicu re-index otomatis (kolom embedding_model).
# Siaran Vee (ADR-016): text-to-speech lewat /audio/speech kompatibel OpenAI di 9router.
# Kosong → base URL & key embedding. Model utama gagal → model cadangan dengan suaranya sendiri.
# Worker butuh ffmpeg + ffprobe untuk konversi ke AAC (.m4a).
AI_TTS_BASE_URL=
AI_TTS_API_KEY=
AI_TTS_MODEL=gemini/gemini-2.5-flash-preview-tts
AI_TTS_VOICE=Leda
AI_TTS_FALLBACK_MODEL=openai/nova
AI_TTS_FALLBACK_VOICE=nova

# Fetch: izinkan URL ke IP privat (hanya untuk tes lokal)
FETCH_ALLOW_PRIVATE=false

# Push FCM HTTP v1: path ke service account JSON Firebase. Kosong = push nonaktif.
FCM_CREDENTIALS_FILE=

# Billing (ADR-011)
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# Email OTP: verifikasi email & reset password (ADR-022). Port 465 = TLS langsung, 587 = STARTTLS.
# Kosong: development menulis email (termasuk kode) ke log API; production mematikan fitur email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vaulty <vaulty@mail.reepzs.site>

WORKER_CONCURRENCY=4
MAX_UPLOAD_MB=5
MAX_UPLOAD_PRO_MB=50
