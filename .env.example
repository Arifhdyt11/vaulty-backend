APP_ENV=development
HTTP_ADDR=:8080

# Postgres dev: docker compose -f docker-compose.dev.yml up -d  (image pgvector/pgvector:pg17)
DATABASE_URL=postgres://vaulty:vaulty@localhost:5434/vaulty?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Maksimal koneksi DB per proses (api & worker). Total semua instance < max_connections Postgres.
DB_MAX_CONNS=10

# Masa berlaku access token (Bearer). Web menyimpannya di sesi NextAuth (ADR-015).
SESSION_TTL=720h
# Registrasi publik baru dibuka di fase multi-tenant. Sebelum itu hanya email di ALLOWED_EMAILS
# yang bisa membuat akun (lewat /auth/register atau login Google pertama kali). Pisahkan dengan koma.
REGISTRATION_OPEN=false
ALLOWED_EMAILS=

STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# Login Google: OAuth dijalankan client (NextAuth/iOS), Go hanya memverifikasi id_token.
# Isi dengan client ID yang sama dengan AUTH_GOOGLE_ID di vaulty-frontend (+ client ID iOS nanti),
# pisahkan dengan koma. Client secret tidak dibutuhkan di sini.
GOOGLE_CLIENT_IDS=

# Provider AI (API kompatibel OpenAI). OPENAI_* untuk chat; embedding ikut server yang sama kecuali
# OPENAI_EMBEDDING_BASE_URL / OPENAI_EMBEDDING_API_KEY diisi. Kosongkan OPENAI_API_KEY untuk menonaktifkan AI
# (search jadi full-text saja, tanpa auto-tag). Ganti provider cukup ubah blok ini lalu restart
# api + worker: note lama otomatis di-embed ulang dengan model baru.
# SEARCH_MAX_DISTANCE / SEARCH_RELATIVE_MARGIN: batas jarak cosine kandidat semantic search.
# Nilainya bergantung model; turunkan jika hasil terlalu berisik.
#
# --- Ollama lokal (default development) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_EMBEDDING_MODEL=bge-m3
OPENAI_CHAT_MODEL=qwen2.5:7b-instruct
SEARCH_MAX_DISTANCE=0.6
SEARCH_RELATIVE_MARGIN=0.08
#
# --- Hermes Agent + 9router di sipantas (jalankan `make tunnel` dulu, ADR-020) ---
# Chat (auto-tag, Vee) lewat Hermes, yang meneruskan ke 9router. Embedding langsung ke 9router,
# karena Hermes tidak punya endpoint /embeddings.
# OPENAI_API_KEY=<API_SERVER_KEY di ~/infra/hermes/.env>
# OPENAI_BASE_URL=http://localhost:8642/v1
# OPENAI_CHAT_MODEL=hermes-vaulty
# OPENAI_EMBEDDING_API_KEY=<API key 9router "vaulty-embed">
# OPENAI_EMBEDDING_BASE_URL=http://localhost:20128/v1
# OPENAI_EMBEDDING_MODEL=<id model text-embedding-3-small di 9router>
# SEARCH_MAX_DISTANCE=0.75
# SEARCH_RELATIVE_MARGIN=0.1
#
# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-5-mini
# SEARCH_MAX_DISTANCE=0.75
# SEARCH_RELATIVE_MARGIN=0.1

WORKER_CONCURRENCY=5
