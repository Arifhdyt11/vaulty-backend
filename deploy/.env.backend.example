# Env produksi di sipantas: ~/apps/vaulty/.env.backend (chmod 600, tidak di-commit).
#
# Catatan nilai:
# - DATABASE_URL: shared-postgres (network data), database khusus v2; v1 tetap di database `vaulty`.
# - LOCAL_STORAGE_DIR: file di volume lokal (storage2:/data); S3/R2 menyusul.
# - AI: hermes (chat) + 9router (vision, embedding, STT, TTS) lewat network web.
# - FCM_CREDENTIALS_FILE: service account Firebase (project vaulty-512801) di
#   ~/apps/vaulty/secrets/fcm-service-account.json; kosong = push nonaktif (reminder tetap
#   ditandai terkirim tanpa notifikasi).
# - SMTP_*: email OTP verifikasi + reset password (ADR-022) lewat Resend SMTP, domain
#   mail.reepzs.site. SMTP_PASS = API key Resend khusus prod; kosong = fitur email mati
#   (/config email_enabled=false). MAIL_REPLY_TO = alamat ber-inbox untuk balasan user.

# Aplikasi
APP_ENV=production
HTTP_ADDR=:8080
BASE_URL=http://43.163.100.39:8080
AUTO_MIGRATE=false

# Log
LOG_JSON=true

# Database
DATABASE_URL=postgres://USER:PASS@postgres:5432/vaulty2?sslmode=disable
DB_MAX_CONNS=8

# Redis
REDIS_URL=redis://vaulty-redis:6379/0

# Autentikasi
APP_SECRET=
ACCESS_TTL=1h
REFRESH_TTL=2160h
REGISTRATION_OPEN=true
ALLOWED_EMAILS=
GOOGLE_CLIENT_IDS=

# Penyimpanan
S3_ENDPOINT=
LOCAL_STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=5
MAX_UPLOAD_PRO_MB=25

# AI
AI_BASE_URL=http://hermes:8642/v1
AI_API_KEY=
AI_CHAT_MODEL=hermes-vaulty
AI_VISION_BASE_URL=http://9router:20128/v1
AI_VISION_API_KEY=
AI_VISION_MODEL=openai/gpt-4o-mini
AI_EMBED_BASE_URL=http://9router:20128/v1
AI_EMBED_API_KEY=
AI_EMBED_MODEL=openai/text-embedding-3-small
AI_EMBED_DIM=1536
AI_STT_BASE_URL=http://9router:20128/v1
AI_STT_API_KEY=
AI_STT_MODEL=groq/whisper-large-v3
AI_TTS_MODEL=gemini/gemini-2.5-flash-preview-tts
AI_TTS_VOICE=Leda
AI_TTS_FALLBACK_MODEL=openai/nova
AI_TTS_FALLBACK_VOICE=nova

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=Vaulty <vaulty@mail.reepzs.site>
MAIL_REPLY_TO=official@reepzs.site

# Pembayaran
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# Notifikasi push
FCM_CREDENTIALS_FILE=/run/vaulty-secrets/fcm-service-account.json

# Worker
WORKER_CONCURRENCY=2
